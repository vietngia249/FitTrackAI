# ==========================================
# FitTrack AI - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack_secret
POSTGRES_DB=fittrack_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://fittrack:fittrack_secret@localhost:5432/fittrack_db?schema=public"

# Redis & Background Jobs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-replace-in-production-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# AI Copilot Configuration (Configurable Provider)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"
LLM_API_KEY=""
LLM_DAILY_CALL_BUDGET=20

# Cloudflare R2 Media Storage (Private photos, videos)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="fittrack-media"
R2_PUBLIC_URL=""

# Observability & Monitoring
SENTRY_DSN=""
LOG_LEVEL="info"
